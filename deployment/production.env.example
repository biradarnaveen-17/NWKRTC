# Copy to a server-only .env file; never commit real values.
# DNS A/AAAA records must point to the EC2 public address.
CADDY_DOMAIN=leave.example.com
ACME_EMAIL=admin@example.com

# Use a unique username and a long randomly generated password.
NWKRTC_ADMIN_USERNAME=change-this-username
NWKRTC_ADMIN_PASSWORD=replace-with-a-long-random-password
