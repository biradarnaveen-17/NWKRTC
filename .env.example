APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./nwkrtc_jobs.sqlite3
TIMEZONE=Asia/Kolkata

# Required when APP_ENV=production. Use a long unique password from a secret store.
NWKRTC_ADMIN_USERNAME=admin
NWKRTC_ADMIN_PASSWORD=replace-with-a-long-random-secret

# Live portal automation is intentionally not implemented in this prototype.
